# Copy this file outside the repo for the first real self-hosted controlled-pilot rehearsal.
# Do not commit real secrets, real customer URLs, or live connector credentials.
# This file is for the single-VM Docker Compose path in compose.prod.example.yml.

AGENTGATE_ENV=production
AGENTGATE_DEBUG=false
AGENTGATE_AUTH_SESSION_MODE=token
AGENTGATE_SECRET_KEY=replace-with-a-long-random-secret

AGENTGATE_DATABASE_URL=postgresql+psycopg://agentgate:replace-with-password@postgres.internal.example:5432/agentgate
AGENTGATE_REDIS_URL=redis://:replace-with-password@redis.internal.example:6379/0

AGENTGATE_PUBLIC_APP_URL=https://agentgate.example.com
AGENTGATE_PUBLIC_API_URL=https://api.agentgate.example.com
AGENTGATE_CORS_ORIGINS=https://agentgate.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.agentgate.example.com

AGENTGATE_ALLOW_INSECURE_PUBLIC_URLS=false
AGENTGATE_ALLOW_PRIVATE_AUDIT_EXPORT_DESTINATIONS=false
AGENTGATE_ALLOW_DEMO_CREDENTIALS=false

AGENTGATE_API_BIND=127.0.0.1
AGENTGATE_API_PORT=8000
AGENTGATE_WEB_BIND=127.0.0.1
AGENTGATE_WEB_PORT=3000

AGENTGATE_KEY_PROVIDER=env
AGENTGATE_PAYLOAD_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
AGENTGATE_PAYLOAD_ENCRYPTION_ACTIVE_KEY_REF=configured-env
AGENTGATE_PAYLOAD_ENCRYPTION_KEY_VERSION=2026-05
AGENTGATE_PAYLOAD_ENCRYPTION_ADDITIONAL_KEYS={}
AGENTGATE_PAYLOAD_ENCRYPTION_ADDITIONAL_KEY_VERSIONS={}

# If you already have AWS KMS ready for the rehearsal, switch to:
# AGENTGATE_KEY_PROVIDER=aws_kms
# AGENTGATE_AWS_REGION=us-east-1
# AGENTGATE_AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/replace-me

AGENTGATE_AUDIT_INTEGRITY_ANCHOR_TYPE=object_storage
AGENTGATE_AUDIT_INTEGRITY_S3_BUCKET=replace-with-bucket
AGENTGATE_AUDIT_INTEGRITY_S3_PREFIX=agentgate/customer-pilot
AGENTGATE_AUDIT_INTEGRITY_S3_REGION=us-east-1
AGENTGATE_AUDIT_INTEGRITY_S3_ENDPOINT_URL=
AGENTGATE_AUDIT_INTEGRITY_S3_ACCESS_KEY_ID_REF=
AGENTGATE_AUDIT_INTEGRITY_S3_SECRET_ACCESS_KEY_REF=
AGENTGATE_AUDIT_INTEGRITY_S3_SESSION_TOKEN_REF=

AGENTGATE_JOB_DISPATCH_MODE=worker
AGENTGATE_JOB_BROKER=redis
AGENTGATE_JOB_REDIS_QUEUE_NAME=agentgate:jobs
AGENTGATE_SCHEDULER_POLL_INTERVAL_SECONDS=5
AGENTGATE_SCHEDULER_BATCH_SIZE=25
AGENTGATE_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
AGENTGATE_WORKER_STALE_AFTER_SECONDS=30

AGENTGATE_RATE_LIMIT_ENABLED=true
AGENTGATE_RATE_LIMIT_PROVIDER=redis
AGENTGATE_ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION=false
AGENTGATE_RATE_LIMIT_FAIL_OPEN_ON_BACKEND_ERROR=false

# Live GitHub rehearsal credentials must be injected outside the browser.
# Use exactly one of the supported paths below and keep the repo allowlist narrow in tool metadata.
AGENTGATE_GITHUB_TOKEN=
AGENTGATE_GITHUB_APP_PRIVATE_KEY=

# Keep optional connectors out of the first live rehearsal unless explicitly reviewed.
AGENTGATE_JIRA_TOKEN=
AGENTGATE_JIRA_API_TOKEN=
AGENTGATE_JIRA_EMAIL=
AGENTGATE_MCP_TOKEN=
AGENTGATE_MCP_API_KEY=

