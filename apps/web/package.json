{
  "name": "agentgate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.16",
    "typescript": "5.7.2"
  }
}
