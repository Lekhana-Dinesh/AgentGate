AGENTGATE_ENV=development
AGENTGATE_DEBUG=true
AGENTGATE_SECRET_KEY=change-me-to-a-long-random-production-secret
AGENTGATE_ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENTGATE_AUTO_CREATE_SCHEMA=false
AGENTGATE_DATABASE_URL=postgresql+psycopg://agentgate:agentgate@postgres:5432/agentgate
AGENTGATE_REDIS_URL=redis://redis:6379/0
AGENTGATE_CORS_ORIGINS=http://localhost:3000
AGENTGATE_DEFAULT_TENANT_PLAN=enterprise-trial
AGENTGATE_PUBLIC_APP_URL=http://localhost:3000
AGENTGATE_PUBLIC_API_URL=http://localhost:8000
AGENTGATE_ALLOW_INSECURE_PUBLIC_URLS=false
AGENTGATE_KEY_PROVIDER=env
AGENTGATE_PAYLOAD_ENCRYPTION_KEY=
AGENTGATE_PAYLOAD_ENCRYPTION_KEY_SECRET_REF=
AGENTGATE_PAYLOAD_ENCRYPTION_ACTIVE_KEY_REF=configured-env
AGENTGATE_PAYLOAD_ENCRYPTION_KEY_VERSION=1
AGENTGATE_PAYLOAD_ENCRYPTION_ADDITIONAL_KEYS={}
AGENTGATE_PAYLOAD_ENCRYPTION_ADDITIONAL_KEY_VERSIONS={}
AGENTGATE_ALLOW_PRIVATE_AUDIT_EXPORT_DESTINATIONS=false
AGENTGATE_OIDC_HTTP_TIMEOUT_SECONDS=5
AGENTGATE_OIDC_STATE_TTL_SECONDS=600
AGENTGATE_OIDC_EXCHANGE_TTL_SECONDS=180
AGENTGATE_BOOTSTRAP_OWNER_EMAIL=owner@demo.agentgate.local
AGENTGATE_BOOTSTRAP_OWNER_PASSWORD=ChangeThis123!
AGENTGATE_BOOTSTRAP_OWNER_NAME=Demo Owner
AGENTGATE_ALLOW_DEMO_CREDENTIALS=false
AGENTGATE_SLACK_NOTIFICATIONS_ENABLED=false
AGENTGATE_SLACK_BOT_TOKEN_ENV_VAR=AGENTGATE_SLACK_BOT_TOKEN
AGENTGATE_SLACK_DEFAULT_CHANNEL=
AGENTGATE_SLACK_BOT_TOKEN=
AGENTGATE_GITHUB_TOKEN=
AGENTGATE_JOB_DISPATCH_MODE=inline
AGENTGATE_JOB_BROKER=database
AGENTGATE_JOB_REDIS_QUEUE_NAME=agentgate:jobs
AGENTGATE_JOB_POLL_INTERVAL_SECONDS=2
AGENTGATE_JOB_WORKER_BATCH_SIZE=10
AGENTGATE_JOB_SLACK_MAX_ATTEMPTS=3
AGENTGATE_JOB_SLACK_RETRY_BACKOFF_SECONDS=30
AGENTGATE_AUDIT_EXPORT_TIMEOUT_SECONDS=5
AGENTGATE_JOB_AUDIT_EXPORT_MAX_ATTEMPTS=3
AGENTGATE_JOB_AUDIT_EXPORT_RETRY_BACKOFF_SECONDS=30
AGENTGATE_JOB_RETENTION_MAX_ATTEMPTS=2
AGENTGATE_JOB_RETENTION_RETRY_BACKOFF_SECONDS=60
AGENTGATE_PAYLOAD_RETENTION_STANDARD_DAYS=30
AGENTGATE_PAYLOAD_RETENTION_SHORT_LIVED_DAYS=7
AGENTGATE_PAYLOAD_RETENTION_EXTENDED_DAYS=90
AGENTGATE_RATE_LIMIT_ENABLED=
AGENTGATE_RATE_LIMIT_LOGIN_LIMIT=5
AGENTGATE_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AGENTGATE_RATE_LIMIT_OIDC_LIMIT=10
AGENTGATE_RATE_LIMIT_OIDC_WINDOW_SECONDS=60
AGENTGATE_RATE_LIMIT_GATEWAY_LIMIT=30
AGENTGATE_RATE_LIMIT_GATEWAY_WINDOW_SECONDS=60
AGENTGATE_RATE_LIMIT_APPROVAL_LIMIT=20
AGENTGATE_RATE_LIMIT_APPROVAL_WINDOW_SECONDS=60
AGENTGATE_RATE_LIMIT_AUDIT_EXPORT_LIMIT=6
AGENTGATE_RATE_LIMIT_AUDIT_EXPORT_WINDOW_SECONDS=300
AGENTGATE_RATE_LIMIT_RETENTION_LIMIT=4
AGENTGATE_RATE_LIMIT_RETENTION_WINDOW_SECONDS=300
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
